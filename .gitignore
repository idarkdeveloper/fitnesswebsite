# ============================================================
# PulseFit — .gitignore
# ============================================================

# ---------- OS artifacts ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- Node / build tooling (in case Tailwind is compiled later) ----------
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
dist/
build/
.cache/
.parcel-cache/
.next/
out/

# ---------- Coverage / tests ----------
coverage/
.nyc_output/

# ---------- Misc ----------
*.tmp
*.bak
*.orig
