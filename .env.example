# Copy this file to ".env" (same folder) and fill in your key.
# ".env" is git-ignored, so your key is never committed or published.
# Used only by tools/generate-images.js on your own computer, never by the website.

# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: image model (default gpt-image-1.5). Examples: gpt-image-2, gpt-image-1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1.5
